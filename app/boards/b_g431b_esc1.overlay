/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Doppelstep on B-G431B-ESC1.
 */

/ {
	chosen {
		/* USART2 carries the DYNAMIXEL bus; console and logs go to RTT. */
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		sfs,servo = &servo;
		sfs,motor = &motor;
	};

	power_stage: power-stage {
		compatible = "sfs,stm32-shared-leg-power-stage";
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch1n_pc13
			     &tim1_ch2_pa9 &tim1_ch2n_pa12
			     &tim1_ch3_pa10 &tim1_ch3n_pb15
			     &adc1_in1_pa0 &adc1_in5_pb14>;
		pinctrl-names = "default";

		timer = <&timers1>;
		adc-master = <&adc1>;
		adc-slave = <&adc2>;
		opamps = <&opamp1 &opamp2 &opamp3>;
		opamp-gain = "OPAMP_GAIN_16";

		/* 20 kHz: TIM1 at 170 MHz, center-aligned, ARR = 4250 */
		pwm-frequency = <20000>;

		/*
		 * Dead time of the ESC1 bridge (0 = not set: outputs refused).
		 * Source: ngspice sweep of one leg (sfs-stepper-power-spice) with
		 * the gate circuit of schematic MB1419 rev C: L6387ED at 10 V,
		 * 33 Ohm gate resistors without turn-off diode, 10k G-S, snubber
		 * 1 Ohm + 10 nF; 24 V, 20 kHz, 25 and 100 degC, -3..+3 A.
		 * Shoot-through up to 600 ns; from 900 ns the Miller bump on the
		 * off gate stays under VGS(th) 3 V. 1200 ns = 900 ns x 1.3 margin
		 * for VGS(th) spread, driver delay mismatch and the fitted MOSFET
		 * model. Reduce only after measuring VGS on the board
		 * (docs/hardware.md, bring-up step 1).
		 */
		dead-time-ns = <1200>;

		/* Low-side time around the top of the counter for the samples: before
		 * the ADC trigger the dead time (1.2 us) and about 1 us of settling,
		 * after it the sampling phases of U, VBUS and W (about 1.5 us). Without
		 * it a duty cycle near 100 % (a 1 A current step at 12 V) corrupted the
		 * VBUS sample and tripped the undervoltage protection on the board.
		 * 2400 ns = 408 of 4250 ticks: the voltage limit drops by 9.6 %.
		 */
		sample-window-ns = <2400>;

		/* OP1_OUT PA2 = ADC1_IN3, OP2_OUT PA6 = ADC2_IN3,
		 * OP3_OUT PB1 = ADC1_IN12, VBUS PA0 = ADC1_IN1
		 */
		phase-u-channel = <3>;
		phase-v-channel = <3>;
		phase-w-channel = <12>;
		vbus-channel = <1>;

		/* Power stage temperature (schematic MB1419 rev C, sheets 4 and 6):
		 * +3.3 V - RT1 NTC - PB14 (ADC1_IN5) - R60 4.7k - GND, C66 10 nF.
		 * RT1 = TDK NTCG103JF103FT1: R25 10 kOhm +-1 %, B25/85 3435 K +-1 %
		 * (B25/50 3380 K; B25/85 fits the 80 degC Temperature Limit).
		 */
		temperature-channel = <5>;
		ntc-r25-ohm = <10000>;
		ntc-beta = <3435>;
		ntc-bottom-ohm = <4700>;

		adc-vref-mv = <3300>;

		/* 3 mOhm shunts, -64/7 = -9.143 V/V (MCSDK, NuttX, SimpleFOC) */
		shunt-micro-ohms = <3000>;
		current-sense-gain-milli = <(-9143)>;

		/* 18k / (18k + 169k) */
		vbus-divider = <18000 169000>;

		/* Hardware trips (schematic MB1419 rev C, sheet 6): each OPAMP+
		 * input is the shunt through 1.5k with 22k to +3.3 V and 2.2k to
		 * GND, V+ = 0.129 V + 4/7 Vshunt (1.71 mV/A); the comparator offset
		 * of +-5 mV is about +-3 A. 10 A: about 3 x trip-current-milliamp
		 * of the motor. 30 V: above vbus-max-mv (28 V).
		 */
		hw-trip-current-milliamp = <10000>;
		hw-trip-vbus-mv = <30000>;

		/* Offsets measured on the board: 2534 (U), 2528 counts = 16 x 0.129 V */
		current-offset-min-counts = <2300>;
		current-offset-max-counts = <2800>;
	};

	motor: motor {
		compatible = "sfs,sstep-motor";
		power-stage = <&power_stage>;

		/* 17HS19-2004S1 */
		phase-resistance-milliohm = <1600>;
		phase-inductance-microhenry = <3000>;
		rated-current-milliamp = <2000>;
		back-emf-uv-s-per-rad = <208600>;
		full-steps-per-rev = <200>;

		vbus-nominal-mv = <24000>;
		vbus-min-mv = <10000>;
		vbus-max-mv = <28000>;
		trip-current-milliamp = <3500>;
		/* The current rises at 30 mA/ms after Torque Enable (1.5 A in 50 ms):
		 * no step on the supply
		 */
		current-slew-ma-per-ms = <30>;
		/* Self-test before the first Torque Enable: 30 % of the rated current */
		selftest-current-milliamp = <600>;
		aux-trip;

		slow-loop-hz = <1000>;
		microsteps = <16>;
		current-bandwidth-hz = <1000>;
		run-current-milliamp = <1500>;
		hold-current-milliamp = <500>;
		hold-delay-ms = <500>;
		max-velocity = <16000>;
		max-acceleration = <64000>;

		motor_drv: driver {
			compatible = "sfs,sstep-stepper-driver";
		};

		motor_ctrl: ctrl {
			compatible = "sfs,sstep-stepper-ctrl";
		};
	};
};

/* DYNAMIXEL Protocol 2.0 bus: ST-LINK VCP for now, 1 Mbps as OpenMANIPULATOR-X */
&usart2 {
	current-speed = <1000000>;
	fifo-enable;

	servo: dxl-servo {
		compatible = "sfs,x430-servo";
		storage = <&storage_partition>;

		/* 17HS19-2004S1 in direct drive: one joint revolution = one motor
		 * revolution = 4096 pulses of the XM430 = 200 x 16 = 3200 microsteps.
		 * With a gearbox: motor revolutions per joint revolution.
		 */
		gear-motor-revs = <1>;
		gear-joint-revs = <1>;
	};
};
