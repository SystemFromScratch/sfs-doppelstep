/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Doppelstep on native_sim/native/64: DYNAMIXEL bus on the second PTY UART.
 * The program prints "uart_1 connected to pseudotty: /dev/pts/N" at start;
 * tools/sim/run_native.py links it to a fixed path (see the README).
 */

/ {
	chosen {
		sfs,servo = &servo;
		sfs,motor = &motor;
	};

	/* The simulated motor, with the ESC1 values of boards/b_g431b_esc1.overlay */
	sim_stage: sim-power-stage {
		compatible = "sfs,sim-power-stage";
		pwm-frequency = <20000>;
		timer-clock-hz = <170000000>;
		adc-vref-mv = <3300>;
		shunt-micro-ohms = <3000>;
		current-sense-gain-milli = <(-9143)>;
		vbus-divider = <18000 169000>;
		microsteps = <16>;
		full-steps-per-rev = <200>;
	};

	motor: motor {
		compatible = "sfs,sstep-motor";
		power-stage = <&sim_stage>;

		/* 17HS19-2004S1 */
		phase-resistance-milliohm = <1600>;
		phase-inductance-microhenry = <3000>;
		rated-current-milliamp = <2000>;
		back-emf-uv-s-per-rad = <208600>;
		full-steps-per-rev = <200>;

		vbus-nominal-mv = <24000>;
		vbus-min-mv = <10000>;
		vbus-max-mv = <28000>;
		trip-current-milliamp = <3500>;
		aux-trip;

		slow-loop-hz = <1000>;
		microsteps = <16>;
		current-bandwidth-hz = <1000>;
		run-current-milliamp = <1500>;
		hold-current-milliamp = <500>;
		hold-delay-ms = <500>;
		max-velocity = <16000>;
		max-acceleration = <64000>;

		motor_drv: driver {
			compatible = "sfs,sstep-stepper-driver";
		};

		motor_ctrl: ctrl {
			compatible = "sfs,sstep-stepper-ctrl";
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <1000000>;

	servo: dxl-servo {
		compatible = "sfs,x430-servo";
		storage = <&storage_partition>;
	};
};
