# Doppelstep application options. Motor, power stage and control parameters
# are properties of the devicetree nodes (app/boards/*.overlay).

mainmenu "Doppelstep"

config SFS_STAGE_OFFSET_SAMPLES
	int "Samples averaged for the current sensor offsets at startup"
	default 1024
	range 16 65535

rsource "Kconfig.app_msg"

menu "Encoder of the joint (chosen sfs,encoder)"

config SFS_ENC_LOST_STEP_USTEPS
	int "Lost step: |commanded - measured| above [microsteps]"
	default 32
	help
	  Beyond two full steps the torque of a stepper turns round: the rotor
	  has slipped. Reported as Overload Error in Hardware Error Status.

config SFS_ENC_SETTLE_MS
	int "Holding time after Torque Enable before the alignment [ms]"
	default 100
	help
	  The rotor snaps to the field at the enable (up to two full steps);
	  then the commanded position is set to the measured one.

config SFS_ENC_CORRECT_MS
	int "Period of the position regulator at standstill [ms]"
	default 10

config SFS_ENC_CORRECTION_MAX_USTEPS
	int "Largest lead of the regulator over the goal [microsteps]"
	default 16
	help
	  One full step: the load angle of the largest holding torque.

endmenu

config SFS_STATUS_LED_BRIGHTNESS
	int "Brightness of the STATUS LED on an LED strip (red, 1..255)"
	default 32
	range 1 255
	help
	  Only for a STATUS LED on an LED strip (chosen sfs,status-led-strip).
	  32 is an eighth of the full current of the red channel.

menu "Threads"

config SFS_CONTROL_THREAD_PRIORITY
	int "Control task priority"
	default -2
	help
	  Cooperative (negative) so that the slow loop is never preempted by
	  another thread.

config SFS_CONTROL_THREAD_STACK_SIZE
	int "Control task stack size"
	default 1536

config SFS_COMM_THREAD_PRIORITY
	int "Communication task priority"
	default 2

config SFS_COMM_THREAD_STACK_SIZE
	int "Communication task stack size"
	default 3584
	help
	  Sized for the X430 emulator 1.0.0, whose status answer put two
	  buffers of CONFIG_X430_DXL2_MAX_PACKET_SIZE on this stack (DXL2-C
	  link). Since 1.1.0 the emulator builds the status packet in place, in
	  its bus instance (x430_servo_data), not on the stack. The size stays
	  until the stack usage is measured on the bench.

endmenu

menu "Supervisor"

config SFS_WATCHDOG
	bool "Hardware watchdog, fed only while every task runs"
	default y
	depends on WATCHDOG && $(dt_alias_enabled,watchdog0)
	select HWINFO
	help
	  main() feeds the watchdog only when the control and the communication
	  task have both run since the last check (src/supervisor.h). A fast
	  loop that leaves the threads no time, or a task that hangs, resets the
	  MCU, which switches the outputs off. The log tells a watchdog reset.

config SFS_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout [ms]"
	default 500
	range 200 5000
	depends on SFS_WATCHDOG
	help
	  Longer than the longest normal pause of a task: a flash page erase of
	  the EEPROM area stalls the CPU for about 20 ms.

config SFS_WATCHDOG_CHECK_MS
	int "Period of the check in main() [ms]"
	default 100
	range 10 1000

endmenu

module = SFS
module-str = doppelstep
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
