# Container and shell files run on Linux: keep LF on Windows checkouts.
* text=auto
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.c text eol=lf
*.h text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.overlay text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
Kconfig* text eol=lf
CMakeLists.txt text eol=lf
*_defconfig text eol=lf
# PowerShell scripts run on the Windows host
*.ps1 text eol=crlf
*.tgz binary
