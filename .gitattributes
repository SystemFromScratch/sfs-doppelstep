# Line endings
#
# The firmware, the scripts and the Python tools run on Linux (Docker image,
# Dev Container, Codespaces, CI), also from a Windows checkout that is bind
# mounted into the container. Every text file is stored and checked out with
# LF, whatever core.autocrlf says; only the scripts of the Windows host keep
# CRLF. After a change of this file: git add --renormalize .
* text=auto eol=lf

# Run by Windows PowerShell on the host
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.bin binary
*.hex binary
*.elf binary
*.tgz binary
*.deb binary

# GitHub language statistics (Linguist)
#
# Doppelstep is firmware in C. The host tools (GUI, simulation launcher,
# documentation builders) and the pytest suites are written in Python and
# would otherwise outweigh the firmware in the language bar of the repository.
# They stay in the repository and in every search; they are only left out of
# the statistics.
tools/** linguist-detectable=false
tests/**/*.py linguist-detectable=false
scripts/*.py linguist-detectable=false

# Generated by tools/docs/diagrams.py: collapsed in diffs
docs/assets/images/*.svg linguist-generated=true
