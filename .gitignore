# Zephyr and west build state
/.west/
**/build/
**/build-*/
# native_sim flash image (emulated EEPROM), written in the working directory of zephyr.exe
flash.bin
/twister-out*/

# Documentation build output (mkdocs build, tools/docs/build_manual.py)
/site/

# Release package (scripts/package_release.py)
/dist/

# Build caches
/.ccache/
**/.cache/

# SEGGER J-Link Software archives (docker/jlink/README.md)
/docker/jlink/*.tgz
/docker/jlink/*.deb

# Python environments and generated files
.venv/
.venv-linux/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# CMake-generated files outside build directories
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json

# Logs and crash dumps
*.log
core
core.*

# Local IDE files (keep shared .vscode project configuration)
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
