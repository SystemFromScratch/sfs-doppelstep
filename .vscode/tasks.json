{
    // Every task runs on Linux (Dev Container or Linux host) through
    // .vscode/workspace-menu.sh and on the Windows host through
    // .vscode/host-menu.ps1; both take the same action names. On Windows,
    // Zephyr runs in the Docker image (compose.yaml) and the debug probe tools
    // come from the host. See docs/development.md.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Workspace Menu",
            "detail": "Pick a Zephyr, debug probe, GUI or documentation action",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "${input:linuxAction}"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "${input:windowsAction}"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: West Init/Update",
            "detail": "west init -l + west update (Windows: in Docker)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Initialize + update"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Initialize + update"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Build",
            "detail": "west build --sysbuild -b b_g431b_esc1 -s app -d build: MCUboot + signed application (Windows: in Docker)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Build firmware"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Build firmware"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Zephyr: Pristine Build",
            "detail": "west build -p always --sysbuild ... (Windows: in Docker)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Pristine build"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Pristine build"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Zephyr: Pristine Build (simulated motor)",
            "detail": "west build -p always --sysbuild ... -- -DEXTRA_DTC_OVERLAY_FILE=sim.overlay: Stepper-C drives a motor model, gate drivers off",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Pristine build (simulated motor)"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Pristine build (simulated motor)"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Zephyr: Build (native_sim)",
            "detail": "west build -b native_sim/native/64 -s app -d build-native (Windows: in Docker)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Build (native_sim)"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Build (native_sim)"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Zephyr: Run (native_sim)",
            "detail": "tools/sim/run_native.py run: bus PTY build-native/ttyDXL (in Docker: also TCP 5555)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Run (native_sim)"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Run (native_sim)"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Run tests (native_sim)",
            "detail": "scripts/run-tests.sh: SIL and integration tests (pytest) -> build-tests/junit.xml (Windows: in Docker)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Run tests (native_sim)"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Run tests (native_sim)"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Clean",
            "detail": "Remove build/",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Clean"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Clean"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Flash (OpenOCD, ST-LINK)",
            "detail": "west flash -r openocd: MCUboot + signed application (Windows: OpenOCD installed on the host)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Flash (OpenOCD, ST-LINK)"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Flash (host OpenOCD, ST-LINK)"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Python: Create .venv",
            "detail": "Virtual environment with requirements.txt (GUI, documentation)",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Create .venv"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Create .venv"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "GUI: Run",
            "detail": "tools/gui/doppelstep_gui.py: test bench and firmware update on the board",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Run GUI"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Run GUI"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Docs: Serve",
            "detail": "mkdocs serve on http://127.0.0.1:8000",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Serve documentation"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Serve documentation"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Docs: Build PDF",
            "detail": "MkDocs + Chromium/Edge -> site/Doppelstep.pdf",
            "type": "process",
            "command": "bash",
            "args": [".vscode/workspace-menu.sh", "Build PDF documentation"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/host-menu.ps1", "Build PDF documentation"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "linuxAction",
            "type": "pickString",
            "description": "Linux / Dev Container action",
            "options": [
                "Initialize + update",
                "Build firmware",
                "Pristine build",
                "Pristine build (simulated motor)",
                "Build (native_sim)",
                "Run (native_sim)",
                "Run tests (native_sim)",
                "Menuconfig",
                "Flash (OpenOCD, ST-LINK)",
                "Flash (J-Link)",
                "Debug server (OpenOCD, ST-LINK)",
                "Debug server (J-Link)",
                "RTT log (OpenOCD)",
                "RTT log (J-Link)",
                "Clean",
                "Ccache stats",
                "Ccache clear",
                "Create .venv",
                "Run GUI",
                "Serve documentation",
                "Build PDF documentation"
            ]
        },
        {
            "id": "windowsAction",
            "type": "pickString",
            "description": "Windows host action (Zephyr in Docker, probe tools on the host)",
            "options": [
                "Initialize + update",
                "Build firmware",
                "Pristine build",
                "Pristine build (simulated motor)",
                "Build (native_sim)",
                "Run (native_sim)",
                "Run tests (native_sim)",
                "Clean",
                "Flash (host OpenOCD, ST-LINK)",
                "GDB server (host OpenOCD, ST-LINK)",
                "GDB server + RTT (host OpenOCD, ST-LINK)",
                "GDB server (host J-Link)",
                "J-Link Remote Server (host)",
                "Create .venv",
                "Run GUI",
                "Serve documentation",
                "Build PDF documentation"
            ]
        }
    ]
}
