{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Zephyr: Workspace Menu",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "case \"${input:zephyrAction}\" in\n  'Initialize + update') bash scripts/west-init.sh ;;\n  'Build firmware') west build -b b_g431b_esc1 -s app -d build ;;\n  'Pristine build') west build -p always -b b_g431b_esc1 -s app -d build ;;\n  'Menuconfig') west build -d build -t menuconfig ;;\n  'Flash (OpenOCD, ST-LINK)') west flash -d build -r openocd ;;\n  'Flash (J-Link)') west flash -d build -r jlink ;;\n  'RTT log (OpenOCD)') west rtt -d build -r openocd ;;\n  'RTT log (J-Link)') west rtt -d build -r jlink ;;\nesac"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: West Init/Update",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/west-init.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Build",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-b",
                "b_g431b_esc1",
                "-s",
                "app",
                "-d",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Zephyr: Pristine Build",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-p",
                "always",
                "-b",
                "b_g431b_esc1",
                "-s",
                "app",
                "-d",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "Zephyr: Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Menuconfig",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-d",
                "build",
                "-t",
                "menuconfig"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Flash (OpenOCD, ST-LINK)",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
                "-d",
                "build",
                "-r",
                "openocd"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Flash (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
                "-d",
                "build",
                "-r",
                "jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Debug server (OpenOCD, ST-LINK)",
            "type": "shell",
            "command": "west",
            "args": [
                "debugserver",
                "-d",
                "build",
                "-r",
                "openocd"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Zephyr: Debug server (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "debugserver",
                "-d",
                "build",
                "-r",
                "jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Zephyr: RTT log (OpenOCD)",
            "type": "shell",
            "command": "west",
            "args": [
                "rtt",
                "-d",
                "build",
                "-r",
                "openocd"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Zephyr: RTT log (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "rtt",
                "-d",
                "build",
                "-r",
                "jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Zephyr: Ccache Stats",
            "type": "shell",
            "command": "ccache",
            "args": [
                "--show-stats"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Zephyr: Ccache Clear",
            "type": "shell",
            "command": "ccache",
            "args": [
                "--clear"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "zephyrAction",
            "type": "pickString",
            "description": "Choose a west action",
            "options": [
                "Initialize + update",
                "Build firmware",
                "Pristine build",
                "Menuconfig",
                "Flash (OpenOCD, ST-LINK)",
                "Flash (J-Link)",
                "RTT log (OpenOCD)",
                "RTT log (J-Link)"
            ]
        }
    ]
}