/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Doppelstep full-bridge board (schematic Stepper-Motor-FOC-Driver, KiCad 8):
 * STM32G431CBU6, TI DRV8412 (two full H-bridges, mode M3..M1 = 000), MA730 magnetic
 * encoder on SPI2, TJA1042 CAN transceiver, eight WS2812B-2020, NTC, 24 V supply.
 *
 * Pin assignment of the schematic:
 *   PA8..PA11  PWM_A..PWM_D (TIM1 CH1..CH4)     PC6   RESET_AB   PA12  RESET_CD
 *   PB11       FAULT                            PB0   OTW
 *   PA1/PA3/PA2  OPAMP1 + / - / out (I_A)       PA7/PA5/PA6  OPAMP2 + / - / out (I_B)
 *   PA0        VBUS (100k / 10k)                PA4   NTC (ADC2_IN17 only)
 *   PB12..PB15 MA730 CS, SCLK, MISO, MOSI (SPI2)
 *   PC10/PC11  USART3 TX/RX (J4)                PB8/PB9  FDCAN1 RX/TX (J6, J7)
 *   PB3        WS2812B data (TIM2 CH2)          PA15  BTN1 (to GND)
 *   PF0/PF1    8 MHz crystal                    PA13/PA14  SWD (J3)
 *
 * The power stage, the motor, the encoder and the servo are described by the
 * application (app/boards/sfs_doppelstep_full_bridge.overlay).
 */

/dts-v1/;
#include <st/g4/stm32g431Xb.dtsi>
#include <st/g4/stm32g431c(6-8-b)ux-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	model = "Doppelstep full-bridge board (DRV8412)";
	compatible = "sfs,doppelstep-full-bridge";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "BTN1 (PA15)";
			/* SW4 to GND through 330 Ohm, 100 nF to GND: no pull-up on the board */
			gpios = <&gpioa 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &user_button;
		watchdog0 = &iwdg;
		led-strip = &leds;
	};

	leds: ws2812 {
		compatible = "sfs,ws2812-stm32-tim";
		pinctrl-0 = <&tim2_ch2_pb3>;
		pinctrl-names = "default";
		timer = <&timers2>;
		channel = <2>;
		dmas = <&dmamux1 0 60 0>;
		chain-length = <8>;
		/* WS2812B-2020: latch after more than 280 us low */
		reset-delay = <300>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};

&clk_lsi {
	status = "okay";
};

/* 8 MHz crystal Y1 on PF0/PF1 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

/* 8 MHz / 2 * 85 / 2 = 170 MHz */
&pll {
	div-m = <2>;
	mul-n = <85>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/* USART3 on J4 (TX, RX with 10k pull-up, GND; 33 Ohm in series). sfs_dxl_uart: the
 * UART of the DYNAMIXEL bus, for MCUboot serial recovery (app/sysbuild/mcuboot.overlay).
 */
sfs_dxl_uart: &usart3 {
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* MA730 magnetic encoder (U7): SPI mode 3, up to 25 MHz, CS on PB12 (R4 10k pull-up) */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	encoder: ma730@0 {
		compatible = "sfs,ma730";
		reg = <0>;
		/* 10 MHz: margin to the 25 MHz of the MA730 on the board traces */
		spi-max-frequency = <10000000>;
	};
};

/*
 * WS2812B-2020 chain D5, D7, D8, D9, D10, D11, D2, D3 on PB3: TIM2 CH2 in PWM mode, one
 * period of 1.25 us per bit, the compare values written by DMA1 channel 1 on every
 * update event (DMAMUX request TIM2_UP = 60). timers2, dma1 and dmamux1 stay disabled:
 * the driver programs them (drivers/ws2812/ws2812_stm32_tim.c).
 */
&timers2 {
	status = "disabled";
};


/*
 * Phase current amplifiers A and B: external feedback (R12/R16, R29/R30: gain
 * 26.5 from the + input), bias from R13/R14, R27/R28. The OPAMPs run standalone,
 * the output stays on its pin for the feedback network and the ADC.
 */
&opamp1 {
	pinctrl-0 = <&opamp1_vinp_pa1 &opamp1_vinm_pa3 &opamp1_vout_pa2>;
	pinctrl-names = "default";
	functional-mode = "standalone";
	inp = "VINP0";
	st,power-mode = "HIGHSPEED";
	status = "okay";
};

&opamp2 {
	pinctrl-0 = <&opamp2_vinp_pa7 &opamp2_vinm_pa5 &opamp2_vout_pa6>;
	pinctrl-names = "default";
	functional-mode = "standalone";
	inp = "VINP0";
	st,power-mode = "HIGHSPEED";
	status = "okay";
};

&iwdg {
	status = "okay";
};

/*
 * 128 KiB of flash, 2 KiB pages, as on the B-G431B-ESC1:
 *
 *   boot_partition     MCUboot (sysbuild, docs/firmware-update.md)
 *   slot0_partition    application, signed; serial recovery writes it
 *   storage_partition  NVS: EEPROM area of the emulated DYNAMIXEL
 */
&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(38)>;
		};

		slot0_partition: partition@9800 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00009800 DT_SIZE_K(86)>;
		};

		/* 2 x 2 KiB flash pages at the end of the 128 KiB of flash */
		storage_partition: partition@1f000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0001f000 DT_SIZE_K(4)>;
		};
	};
};
