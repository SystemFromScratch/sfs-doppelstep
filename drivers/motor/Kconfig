menuconfig SSTEP_MOTOR
	bool "Stepper motor driver built on Stepper-C"
	default y
	depends on DT_HAS_SFS_SSTEP_MOTOR_ENABLED
	select STEPPER
	select SSTEP
	select POWER_STAGE

if SSTEP_MOTOR

config SSTEP_MOTOR_INIT_PRIORITY
	int "Motor driver init priority"
	default 75
	help
	  After the power stage.

config SSTEP_MOTOR_CHILD_INIT_PRIORITY
	int "Init priority of the stepper and stepper_ctrl child devices"
	default 76
	help
	  After the parent device.

config SSTEP_MOTOR_SELFTEST
	bool "Self-test of the bridge and the motor before the first enable"
	default n if DT_HAS_SFS_SIM_POWER_STAGE_ENABLED && !ARCH_POSIX
	default y
	select SSTEP_SELFTEST
	help
	  At the first enable after start (and after clearing the faults),
	  sstep_selftest() of Stepper-C gives each phase the test current of
	  selftest-current-milliamp at a slowly rising voltage; with three legs the
	  driver also checks that the leg currents add up to 0 (the shunt of the
	  shared leg). A phase without current, a short, a current of the wrong
	  sign, a phase on the wrong legs, a current with all legs low or a broken
	  sensor refuses the enable and latches SSTEP_MOTOR_FAULT_SELFTEST. Off by
	  default for the simulated motor on a board (flash); on for native_sim,
	  where the SIL tests run it against the model.

config SSTEP_MOTOR_SELFTEST_EVERY_ENABLE
	bool "Run the self-test at every enable"
	depends on SSTEP_MOTOR_SELFTEST
	help
	  The rotor moves to the nearest full step of the tested coil (at most
	  one full step) and back, at every enable.

config SSTEP_MOTOR_MCUVIEWER
	bool "Measurement variables and capture buffer for MCUViewer"
	help
	  Only for measurements on the bench; off in every release build.
	  The fast loop publishes the measured phase currents, the commanded
	  phase voltages, their averages and the peak-to-peak current in the
	  global variable `mcuv`, and records them into `mcuv_buf` on request
	  (mcuv.capture_arm = 1). MCUViewer, a debugger or
	  tools/mcuviewer/mcuv.py read them over SWD while the motor runs:
	  current ripple at rest and effective dead time without a current
	  probe (docs/measurements.md). Costs RAM for the buffer and a few
	  tens of CPU cycles per fast-loop period: check `fast loop max`.
	  One motor instance is recorded: the first one to start.

config SSTEP_MOTOR_MCUVIEWER_SAMPLES
	int "Points of the capture buffer"
	depends on SSTEP_MOTOR_MCUVIEWER
	default 1024
	range 16 8192
	help
	  8 bytes per point (phase currents and voltages). 1024 points are
	  51 ms at 20 kHz, or about 1 s with a divider of 20.

config SSTEP_MOTOR_THREAD_CHECK
	bool "Check that every call comes from one thread"
	default y if ASSERT

module = SSTEP_MOTOR
module-str = sstep_motor
source "subsys/logging/Kconfig.template.log_config"

endif # SSTEP_MOTOR
